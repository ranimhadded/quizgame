<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/host_pack"
    android:orientation="vertical"
    android:background="#F97316"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        style="@style/Widget.Material3.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#F97316"
        android:layout_marginTop="35dp"
        android:titleTextColor="@android:color/white"
        app:titleCentered="true"
        android:title="Choose a Topic"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/arrow_back"
        app:navigationIconTint="@android:color/white" />

    <!-- MAIN CONTENT - This will take all available space -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MAIN CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:background="@android:color/white">

                    <!-- TITLE + IMAGE -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/topicNameText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="General knowledge"
                            android:textColor="#333333"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/topicImageView"
                            android:src="@drawable/friends"
                            android:layout_width="100dp"
                            android:layout_height="100dp" />
                    </LinearLayout>

                    <!-- HOST ROOM BUTTON -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="32dp">

                        <Button
                            android:id="@+id/hostroombutton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Host Room"
                            android:textStyle="bold"
                            android:paddingLeft="32dp"
                            android:paddingRight="32dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:backgroundTint="#6331B5"
                            android:textColor="@android:color/white" />
                    </LinearLayout>

                    <!-- ========== WHO CAN JOIN ========== -->
                    <LinearLayout
                        android:id="@+id/layoutWhoCanJoin"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:text="Who can join ?"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_height="wrap_content">

                            <Button
                                android:id="@+id/btnInviteOnly"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_height="wrap_content"
                                android:text="invite only"
                                android:textColor="@android:color/white"
                                android:backgroundTint="#6331B5" />

                            <Button
                                android:id="@+id/btnMyFriends"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_height="wrap_content"
                                android:text="My friends"
                                android:textColor="#666666"
                                android:backgroundTint="#EDE9FE" />

                            <Button
                                android:id="@+id/btnAnyone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:backgroundTint="#EDE9FE"
                                android:text="  Anyone "
                                android:textColor="#666666" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ========== QUESTIONS PER GAME ========== -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:text="Questions per game"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_height="wrap_content">

                            <Button
                                android:id="@+id/btnQuestions10"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:textColor="@android:color/white"
                                android:backgroundTint="#6331B5" />

                            <Button
                                android:id="@+id/btnQuestions15"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_height="wrap_content"
                                android:text="15"
                                android:textColor="#666666"
                                android:backgroundTint="#EDE9FE" />

                            <Button
                                android:id="@+id/btnQuestions20"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="20"
                                android:textColor="#666666"
                                android:backgroundTint="#EDE9FE" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ========== QUESTION TIMER ========== -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:text="Question timer"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_height="wrap_content">

                            <Button
                                android:id="@+id/btnTimer15s"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_height="wrap_content"
                                android:text="15s"
                                android:textColor="@android:color/white"
                                android:backgroundTint="#6331B5" />

                            <Button
                                android:id="@+id/btnTimer30s"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_height="wrap_content"
                                android:text="30s"
                                android:textColor="#666666"
                                android:backgroundTint="#EDE9FE" />

                            <Button
                                android:id="@+id/btnTimer60s"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="60s"
                                android:textColor="#666666"
                                android:backgroundTint="#EDE9FE" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ========== DIFFICULTY ========== -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:text="Difficulty"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_height="wrap_content">

                            <Button
                                android:id="@+id/btnDifficultyEasy"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_height="wrap_content"
                                android:text="Easy"
                                android:textColor="@android:color/white"
                                android:backgroundTint="#6331B5" />

                            <Button
                                android:id="@+id/btnDifficultyMedium"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:layout_height="wrap_content"
                                android:text="Medium"
                                android:textColor="#666666"
                                android:backgroundTint="#EDE9FE" />

                            <Button
                                android:id="@+id/btnDifficultyHard"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Hard"
                                android:textColor="#666666"
                                android:backgroundTint="#EDE9FE" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</LinearLayout>