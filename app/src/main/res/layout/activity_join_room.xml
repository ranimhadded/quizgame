<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/join_room"
    android:background="#F97316"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        style="@style/Widget.Material3.Toolbar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="35dp"
        android:background="#F97316"
        android:title="Choose a Topic"
        app:titleCentered="true"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/arrow_back"
        app:navigationIconTint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- FIRST CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_topic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="20dp">

            <!-- TITLE + IMAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/topicNameText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="General knowledge"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"/>

                <ImageView
                    android:id="@+id/topicImageView"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/friends"/>
            </LinearLayout>

            <!-- SHARE + BUTTON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/shareCodetxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share code"
                    android:textSize="17sp"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:id="@+id/gameStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting for host to start..."
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="center_horizontal"/>
                <Button
                    android:id="@+id/CodeBtn"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="758215"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:backgroundTint="#6331B5"
                    android:drawableStart="@drawable/share"
                    android:drawableTint="@android:color/white"
                    android:drawablePadding="24dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- SECOND CARD -->

        <View
        android:id="@+id/divider_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="80dp"
        android:layout_marginTop="48dp"
        android:background="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_topic" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_players"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/divider_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="20dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for players..."
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Replace the entire card_players LinearLayout content with: -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/players_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/submit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-30dp"
        android:text="Start Now"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        app:backgroundTint="#6331B5"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="@id/card_players"
        app:layout_constraintEnd_toEndOf="@id/card_players"
        app:layout_constraintStart_toStartOf="@id/card_players" />

    <!-- BOTTOM NAVIGATION -->
    </androidx.constraintlayout.widget.ConstraintLayout>
